{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/app/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"padelklubben.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privatliv",
      "destination": "/privatliv.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/nyt",
      "destination": "/nyt.html"
    },
    {
      "source": "/tv/:token",
      "destination": "/tv.html"
    }
  ],
  "redirects": [
    {
      "source": "/android",
      "destination": "https://play.google.com/apps/internaltest/4701396856686669522",
      "permanent": false
    }
  ]
}
